# ============================================================
# Time-Off Microservice — Environment Configuration
# TRD v1, Section 13.1 — All 9 Required Variables
# ============================================================

# --- Database ---
# Path to SQLite file. Use absolute path in production.
# Must be on a persistent volume (not ephemeral container storage).
DATABASE_PATH=./data/timeoff.db

# --- HCM Integration ---
# Base URL of the HCM real-time API (Workday / SAP)
HCM_BASE_URL=http://localhost:4000/hcm

# API key for HCM authentication (Bearer token)
HCM_API_KEY=your-hcm-api-key-here

# HMAC-SHA256 shared secret for verifying inbound HCM webhooks
HCM_WEBHOOK_SECRET=your-webhook-secret-here

# Timeout in milliseconds for all outbound HCM API calls
HCM_TIMEOUT_MS=5000

# Number of consecutive HCM failures before circuit breaker opens
HCM_CIRCUIT_THRESHOLD=5

# --- Background Jobs ---
# Interval in milliseconds for the reconciliation cron job (default: 15 minutes)
RECONCILIATION_INTERVAL_MS=900000

# --- Idempotency ---
# TTL in seconds for duplicate request detection window (default: 24 hours)
IDEMPOTENCY_TTL_SECONDS=86400

# --- Auth (local dev only; Gateway handles JWT in production) ---
JWT_SECRET=dev-secret-change-in-production
